# =============================================================================
# Task Management API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port the HTTP server listens on (default: 3000)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Path to the SQLite database file (default: ./data/tasks.db)
DATABASE_PATH=./data/tasks.db

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens. MUST be a strong random string (min 32 chars).
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars

# JWT token expiration (e.g., "1h", "7d") (default: 24h)
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Max requests per window for general API routes (default: 100)
RATE_LIMIT_GENERAL_MAX=100

# Max requests per window for auth routes (default: 10)
RATE_LIMIT_AUTH_MAX=10

# Rate limit window in minutes (default: 15)
RATE_LIMIT_WINDOW_MINUTES=15

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info
